# Test coverage
coverage/

# Dependencies
node_modules/

# Build output
# NOTE: dist/ and bin/ are committed so the marketplace can distribute the plugin
# without relying on a postinstall build. They are rebuilt on every release via
# the semantic-release prepareCmd. Do not re-ignore them.
# The negations below override a global ~/.gitignore that ignores dist/.
!dist/
!dist/**
!bin/
!bin/**

# Logs
*.log
logs/

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Git worktrees
.worktrees/

.claude/scheduled_tasks.lock
