#!/usr/bin/env bash
# Resolves the episodic-memory binary (override, installed, or downloaded
# from the GitHub Release) and execs it with all arguments.
#
# Install lock: `flock` when available (Linux); otherwise an atomic
# `mkdir` spin lock (macOS has no flock(1) by default), 300s timeout.
set -u

REPO="baleen37/episodic-memory"

FIRST_ARG="${1:-}"

fail() {
  echo "episodic-memory: $*" >&2
  # SessionStart hooks must never fail the session.
  if [ "$FIRST_ARG" = "sync" ]; then exit 0; fi
  exit 1
}

if [ -n "${EPISODIC_MEMORY_BIN:-}" ]; then
  exec "$EPISODIC_MEMORY_BIN" "$@"
fi

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VER="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$SELF_DIR/../.claude-plugin/plugin.json" | head -n 1)"
[ -n "$VER" ] || fail "cannot read version from plugin.json"

DATA_DIR="${EPISODIC_MEMORY_DIR:-$HOME/.config/episodic-memory}"
BIN_DIR="$DATA_DIR/bin"
BIN="$BIN_DIR/episodic-memory-v$VER"

if [ -x "$BIN" ]; then
  exec "$BIN" "$@"
fi

OS="$(uname -s)"
ARCH="$(uname -m)"
case "$OS/$ARCH" in
  Darwin/arm64) TARGET="aarch64-apple-darwin" ;;
  Linux/x86_64) TARGET="x86_64-unknown-linux-gnu" ;;
  Linux/aarch64 | Linux/arm64) TARGET="aarch64-unknown-linux-gnu" ;;
  *) fail "unsupported platform $OS/$ARCH" ;;
esac

install_binary() {
  # Re-check: another process may have installed while we waited for the lock.
  [ -x "$BIN" ] && return 0

  local name="episodic-memory-v$VER-$TARGET"
  local url="https://github.com/$REPO/releases/download/v$VER/$name"
  local tmp
  tmp="$(mktemp -d "$BIN_DIR/.install.XXXXXX")" || return 1

  if ! curl -fsSL -o "$tmp/$name.tar.gz" "$url.tar.gz" ||
    ! curl -fsSL -o "$tmp/$name.tar.gz.sha256" "$url.sha256"; then
    echo "episodic-memory: download failed: $url.tar.gz" >&2
    rm -rf "$tmp"
    return 1
  fi

  local sum_cmd
  if command -v shasum >/dev/null 2>&1; then
    sum_cmd="shasum -a 256"
  else
    sum_cmd="sha256sum"
  fi
  # The .sha256 file is "<hex>  <name>.tar.gz"; check against the local name.
  local expected
  expected="$(awk '{print $1; exit}' "$tmp/$name.tar.gz.sha256")"
  if ! (cd "$tmp" && printf '%s  %s\n' "$expected" "$name.tar.gz" | $sum_cmd -c - >/dev/null 2>&1); then
    echo "episodic-memory: sha256 mismatch for $name.tar.gz" >&2
    rm -rf "$tmp"
    return 1
  fi

  if ! tar -xzf "$tmp/$name.tar.gz" -C "$tmp" episodic-memory; then
    echo "episodic-memory: failed to extract $name.tar.gz" >&2
    rm -rf "$tmp"
    return 1
  fi
  chmod 0755 "$tmp/episodic-memory"
  mv "$tmp/episodic-memory" "$BIN" || {
    rm -rf "$tmp"
    return 1
  }
  rm -rf "$tmp"
}

mkdir -p "$BIN_DIR" || fail "cannot create $BIN_DIR"
LOCK="$BIN_DIR/.install.lock"

if command -v flock >/dev/null 2>&1; then
  (
    flock -w 300 9 || exit 1
    install_binary
  ) 9>"$LOCK" || fail "install failed"
else
  LOCK_DIR="$LOCK.d"
  waited=0
  until mkdir "$LOCK_DIR" 2>/dev/null; do
    waited=$((waited + 1))
    [ "$waited" -le 300 ] || fail "timed out waiting for install lock $LOCK_DIR"
    sleep 1
  done
  trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT
  install_binary || fail "install failed"
  rmdir "$LOCK_DIR" 2>/dev/null
  trap - EXIT
fi

[ -x "$BIN" ] || fail "binary missing after install"
exec "$BIN" "$@"
