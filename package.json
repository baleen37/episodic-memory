{
  "name": "@baleen/memmem",
  "version": "1.12.1",
  "private": false,
  "type": "module",
  "description": "Memmem - Conversation memory with semantic search across Claude Code and Codex sessions",
  "repository": {
    "type": "git",
    "url": "https://github.com/baleen37/memmem"
  },
  "homepage": "https://github.com/baleen37/memmem",
  "license": "MIT",
  "keywords": [
    "memory",
    "transcripts",
    "search",
    "codex",
    "claude"
  ],
  "scripts": {
    "postinstall": "bash scripts/conditional-build.sh",
    "build": "bun scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "compat:check": "bash scripts/verify-runtime-compatibility.test.sh",
    "compat:preflight": "bash scripts/preflight-runtime-compatibility.sh",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "cli": "bun dist/cli-internal.mjs"
  },
  "bin": {
    "memmem": "bin/memmem"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "marked": "^17.0.1",
    "sqlite-vec": "^0.1.6",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/bun": "^1.3.9",
    "bun-types": "^1.3.9",
    "semantic-release": "^24.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
